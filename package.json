{
  "name": "whisper-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run clean:port && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npm run clean:port && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "clean:port": "node -e \"const {execSync}=require('child_process');try{const r=execSync('netstat -ano | findstr :5173 | findstr LISTENING',{encoding:'utf8'});const pids=[...new Set(r.split('\\n').map(l=>l.trim().split(/\\s+/).pop()).filter(Boolean))];pids.forEach(p=>{try{execSync('taskkill /PID '+p+' /F')}catch(e){}});console.log('Cleaned port 5173')}catch(e){console.log('Port 5173 is free')}\"",
    "test:ai": "node tests/orchestratorTest.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "function-plot": "^1.25.3",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  }
}
